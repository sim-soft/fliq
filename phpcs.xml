<?xml version="1.0"?>
<ruleset name="FLIQ">
    <description>PSR-12, enforced as errors. Line length is advisory.</description>

    <file>src</file>

    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="p"/>

    <rule ref="PSR12"/>

    <!--
        PSR-12 gives a soft limit of 120 characters and says a check "must not"
        treat it as a hard error. phpcs reports it as a warning, which is the
        same thing said twice, so failing the build on it would enforce what the
        standard explicitly declines to enforce.

        There are 48 such lines in src, the longest 164 characters, mostly long
        explanatory comments above the defect fixes they describe. Rewrapping
        them is a judgement call about where a sentence should break, not a
        formatting fix phpcbf can make, so they are reported and not enforced.
    -->
    <rule ref="Generic.Files.LineLength">
        <severity>3</severity>
    </rule>
</ruleset>
